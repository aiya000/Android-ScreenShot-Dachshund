<?xml version="1.0" encoding="utf-8"?>
<!--
    A miniature dachshund in profile: the long low body, the short legs, the long head, the
    drooping ear and the tail up. Kept inside the 66dp safe circle of an adaptive icon
    (21..87 on this canvas), so no launcher mask cuts the dog.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Drawn at full size and shrunk about the centre, so that the tail tip and the nose
         stay inside the safe circle. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">

    <!-- the tail, up and curling -->
    <path
        android:pathData="M25,55 Q17,51 19,41"
        android:strokeColor="#FFF4E0"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- the body -->
    <path
        android:fillColor="#FFF4E0"
        android:pathData="M30,50h42a8,8 0,0 1,8 8v0a8,8 0,0 1,-8 8h-42a8,8 0,0 1,-8 -8v0a8,8 0,0 1,8 -8z" />

    <!-- the legs -->
    <path
        android:fillColor="#FFF4E0"
        android:pathData="M26,64h7v10a2,2 0,0 1,-2 2h-3a2,2 0,0 1,-2 -2zM35,64h7v10a2,2 0,0 1,-2 2h-3a2,2 0,0 1,-2 -2zM60,64h7v10a2,2 0,0 1,-2 2h-3a2,2 0,0 1,-2 -2zM69,64h7v10a2,2 0,0 1,-2 2h-3a2,2 0,0 1,-2 -2z" />

    <!-- the neck and the long head, nose to the right -->
    <path
        android:fillColor="#FFF4E0"
        android:pathData="M66,54 L70,41 Q72,34 80,34 L83,34 Q89,35 90,41 L90,44 Q90,48 86,48 L82,48 Q78,49 76,52 L70,54z" />

    <!-- the ear, a long drop over the neck -->
    <path
        android:fillColor="#E3BE8F"
        android:pathData="M75,36 Q67,38 67,49 Q67,56 71,56 Q75,55 76,46 Q77,40 75,36z" />

    <!-- the eye and the nose -->
    <path
        android:fillColor="#3B2A1E"
        android:pathData="M80.5,39.5a1.6,1.6 0,1 0,3.2 0a1.6,1.6 0,1 0,-3.2 0zM88.5,38.6a1.6,1.6 0,1 0,3.2 0a1.6,1.6 0,1 0,-3.2 0z" />
    </group>
</vector>
