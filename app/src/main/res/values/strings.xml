    <!-- the accessibility service, as the system settings show it -->
    <string name="service_label">ScreenShot Dachshund</string>
    <string name="service_summary">Takes scrolling screenshots</string>
    <string name="service_description">Takes a screenshot, scrolls the app on screen, takes another, and joins them into one tall image. The service reads nothing from the screen: it only takes screenshots, scrolls, and listens for scroll events while a capture runs.</string>

